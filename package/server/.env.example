DATABASE_URL = "YOUR_POSTGRES_URL_HERE"

# 中台对外可访问地址（计算后端通过此地址回调下载文件）
PUBLIC_URL = "http://localhost:3456"

# RustFS (S3-compatible object storage) 配置
RUSTFS_ENDPOINT = "http://localhost:9000"
RUSTFS_ACCESS_KEY = "watercondition"
RUSTFS_SECRET_KEY = "watercondition"
RUSTFS_BUCKET = "water-condition"
RUSTFS_REGION = "us-east-1"
RUSTFS_PUBLIC_URL = "http://localhost:9000/water-condition"